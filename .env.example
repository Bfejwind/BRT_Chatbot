# Existing production path: keep this value while preparing Meta.
WHATSAPP_PROVIDER=360dialog
WHATSAPP_API_KEY=
D360_WEBHOOK_SECRET=
VERIFY_TOKEN=

# Meta app configuration; use actual values only in ignored .env / host secrets.
FACEBOOK_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0

# Production Meta credentials: not activated until WHATSAPP_PROVIDER=meta.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Isolated test endpoint, disabled unless explicitly enabled.
META_TEST_ENABLED=false
META_TEST_ACCESS_TOKEN=
META_TEST_PHONE_NUMBER_ID=
META_TEST_WABA_ID=
META_TEST_VERIFY_TOKEN=
# Country code + digits; only these test recipients receive a test acknowledgment.
META_TEST_RECIPIENTS=6582064900

# Keep v2 until the approved v3 wording is deliberately activated on the bot host.
BOOKING_REMINDER_FORMAT=full_v2
# Standalone stage: set META_TEST_ENABLED=true only in that process/service.
META_TEST_HOST=127.0.0.1

# Existing Supabase/Google Calendar/reminder settings are still required by server.js.
